{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "sh \"$CLAUDE_PLUGIN_ROOT/bin/ensure-login.sh\"", "timeout": 600 } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_hiccup-data_hiccup-data__(find|aggregate|count|export)",
        "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PLUGIN_ROOT/bin/guard-analytics-view.js\"", "timeout": 10 } ]
      }
    ]
  }
}
